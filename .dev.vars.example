# Local secrets for "npm run dev:worker" (wrangler dev). Copy this file to .dev.vars, which is gitignored, and fill
# in only what you need; an empty value is the same as an unset one. Production and beta secrets never live in a
# file: set them with "npx wrangler secret put <NAME>" (and "--env beta"). The names match worker/lib/env.ts.

# Talk needs the D1 binding in wrangler.jsonc (local under wrangler dev) with every migration applied:
# "npx wrangler d1 migrations apply emersa-memory --local". Until then every Talk route answers 503.

# Phase 2: keys the signed visitor id cookie (worker/lib/consent.ts). 32 random bytes as hex: openssl rand -hex 32
VISITOR_HMAC_KEY=

# Phase 2, optional: Turnstile secret for POST /api/talk/session (worker/lib/turnstile.ts). Empty means no person
# check: the route then runs on the tighter unguarded caps (3 sessions and 60 turns a visitor a day). The Turnstile
# docs publish test keys that always pass or always fail, for the browser flow in development.
TURNSTILE_SECRET=

# Phase 2: Convai API key. POST /api/talk/session mints a one-hour token with it (worker/lib/convai.ts); the key
# itself never reaches the browser. Without it (or without CONVAI_CHARACTER_ID) Talk answers 503.
CONVAI_API_KEY=

# Phase 2, dev and beta only: NVIDIA NIM key for the text brain, POST /api/brain (needs NIM_BASE_URL set).
NVIDIA_API_KEY=

# Stripe (routes/pay.ts): the secret key opens Checkout for "Buy 60 minutes" and reads it back; the webhook
# signing secret checks POST /api/pay/webhook. Use the sk_test_ / whsec_ pair from Stripe's test mode first.
# Without the secret key Talk offers no Buy button and the pay routes answer 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
