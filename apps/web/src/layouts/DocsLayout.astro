---
/**
 * The frame around every /docs page: the Base shell without a being, the page head and prose styles shared with
 * the legal pages, an "On this page" list, prev/next links, the way back into the tour, and a sidebar of every doc
 * grouped by section. The sidebar follows the article in the DOM so the content comes first on small screens.
 */
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { groupDocs, sortDocs } from '../content.config.ts';
import { site } from '../data/site.ts';
import { graph, webPage } from '../lib/schema.ts';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { title, description, section, updated, tour } = entry.data;
const { chrome, sections } = site.docs;

const all = sortDocs(await getCollection('docs'));
const groups = groupDocs(all);
const position = all.findIndex((doc) => doc.id === entry.id);
const previous = position > 0 ? all[position - 1] : undefined;
const next = position >= 0 ? all[position + 1] : undefined;

// Only second-level headings make the contents list; deeper ones would turn it into a copy of the page.
const contents = headings.filter((heading) => heading.depth === 2);

const updatedIso = updated.toISOString().slice(0, 10);
const updatedText = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(updated);

// "Take the tour from here" lands on the stop the doc names in its front matter, or on the technology stop.
const tourHref = `/?tour=${tour ?? 'technology'}`;

const schema = graph({
  ...webPage(`/docs/${entry.id}`, title, description, 'TechArticle'),
  headline: title,
  dateModified: updatedIso,
});
---

<Base title={title} description={description} being="none" ogType="article" schema={schema}>
  <div class="container section docs">
    <article class="doc">
      <header class="page-head">
        <p class="eyebrow">{sections[section]}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="page-meta">
          {chrome.updated} <time datetime={updatedIso}>{updatedText}</time>
        </p>
      </header>

      {
        contents.length > 1 && (
          <nav class="doc-contents" aria-label={chrome.contents}>
            <p class="doc-contents-label">{chrome.contents}</p>
            <ol>
              {contents.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose">
        <slot />
      </div>

      <footer class="doc-footer">
        <nav class="doc-pager" aria-label={chrome.pager}>
          {
            previous ? (
              <a class="doc-pager-link" rel="prev" href={`/docs/${previous.id}`}>
                <span class="doc-pager-label">{chrome.previous}</span>
                <span class="doc-pager-title">{previous.data.title}</span>
              </a>
            ) : (
              <span class="doc-pager-empty" />
            )
          }
          {
            next ? (
              <a class="doc-pager-link doc-pager-next" rel="next" href={`/docs/${next.id}`}>
                <span class="doc-pager-label">{chrome.next}</span>
                <span class="doc-pager-title">{next.data.title}</span>
              </a>
            ) : (
              <span class="doc-pager-empty" />
            )
          }
        </nav>
        <a class="doc-tour" href={tourHref}>{site.tour.resumeHere}</a>
      </footer>
    </article>

    <nav class="docs-nav" aria-label={site.docs.eyebrow}>
      <a class="docs-nav-home" href="/docs">{site.docs.eyebrow}</a>
      {
        groups.map((group) => (
          <div class="docs-nav-group">
            <p class="docs-nav-label" id={`docs-nav-${group.id}`}>
              {sections[group.id]}
            </p>
            <ul class="docs-nav-list" aria-labelledby={`docs-nav-${group.id}`}>
              {group.docs.map((doc) => (
                <li>
                  <a href={`/docs/${doc.id}`} aria-current={doc.id === entry.id ? 'page' : undefined}>
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    gap: 3rem;
  }

  .doc {
    min-width: 0;
  }

  .doc-contents-label,
  .doc-pager-label,
  .docs-nav-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .doc-contents {
    max-width: 68ch;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .doc-contents-label {
    margin-bottom: 0.6rem;
  }

  .doc-contents ol {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }

  .doc-contents a {
    color: var(--ink-2);
  }

  .doc-contents a:hover {
    color: var(--accent-text);
  }

  /* Shiki renders both themes: the light colours inline, the dark ones in custom properties. The block follows
     html[data-theme] like everything else; the fallbacks keep it readable if the inline colours are refused. */
  :global(html:not([data-theme='light'])) .prose :global(.astro-code) {
    color: var(--shiki-dark, var(--ink)) !important;
    background-color: var(--shiki-dark-bg, var(--bg-2)) !important;
  }

  :global(html:not([data-theme='light'])) .prose :global(.astro-code span) {
    color: var(--shiki-dark, var(--ink)) !important;
    background-color: var(--shiki-dark-bg, transparent) !important;
  }

  .doc-footer {
    display: grid;
    gap: 1.5rem;
    max-width: 68ch;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .doc-pager {
    display: grid;
    gap: 1rem;
  }

  .doc-pager-link {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--dur-fast);
  }

  .doc-pager-link:hover {
    border-color: var(--ink-muted);
  }

  .doc-pager-title {
    font-weight: 600;
  }

  .doc-pager-next {
    text-align: right;
  }

  .doc-tour {
    justify-self: start;
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-nav {
    font-size: var(--text-sm);
  }

  .docs-nav-home {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }

  .docs-nav-group + .docs-nav-group {
    margin-top: 1.25rem;
  }

  .docs-nav-label {
    margin-bottom: 0.5rem;
  }

  .docs-nav-list {
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .docs-nav-list a {
    display: block;
    margin-left: -1px;
    padding: 0.4rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--ink-muted);
  }

  .docs-nav-list a:hover {
    color: var(--ink);
  }

  .docs-nav-list a[aria-current='page'] {
    border-left-color: var(--accent);
    color: var(--accent-text);
  }

  @media (min-width: 560px) {
    .doc-pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .docs {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: 4rem;
      align-items: start;
    }

    .docs-nav {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      max-height: calc(100vh - var(--header-h) - 3rem);
      overflow-y: auto;
    }

    .doc {
      grid-column: 2;
      grid-row: 1;
    }
  }

</style>
