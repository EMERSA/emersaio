---
/**
 * The partners: a centred label with its Pause control, then two identical groups of logos sliding left for ever
 * on the flat page (the second is hidden from assistive technology and from the tab order), pausing on hover,
 * keyboard focus and the Pause control (main.ts), and wrapping into a static row under reduced motion. Each group
 * holds the list twice, so one group is wider than any band and the loop never shows a gap. Logos are the files
 * as supplied, with no filter. The sentences under the band are the words agreed with each partner, verbatim.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { type Partner, site } from '../data/site.ts';

// Logos live in src/assets/partners so each file gets a hashed URL with a long cache; a replaced file is never served stale.
const files = import.meta.glob<ImageMetadata>('../assets/partners/*.{png,svg,webp}', { eager: true, import: 'default' });
const logo = (name?: string): ImageMetadata | undefined => (name ? files[`../assets/partners/${name}`] : undefined);

interface Logo {
  src: string;
  width: number;
  height: number;
}

/** Twice the slot height in CSS pixels (28px, or 38px for a stacked lockup), for sharp logos on dense screens. */
const LOGO_PX = 56;
const STACKED_PX = 76;

/** A raster logo is served at twice its display size rather than at the source's thousand pixels; SVG stays as is. */
const prepare = async (meta: ImageMetadata | undefined, stacked: boolean): Promise<Logo | undefined> => {
  if (!meta) return undefined;
  if (meta.format === 'svg') return { src: meta.src, width: meta.width, height: meta.height };
  const image = await getImage({ src: meta, height: stacked ? STACKED_PX : LOGO_PX, format: 'webp' });
  return { src: image.src, width: Number(image.attributes.width), height: Number(image.attributes.height) };
};

const partners = await Promise.all(
  site.partners.items.map(async (partner: Partner) => {
    const lightMeta = logo(partner.logo);
    if (partner.logo && !lightMeta) console.warn(`[partners] no file for ${partner.name}: ${partner.logo}`);
    const stacked = partner.logoStacked === true;
    const light = await prepare(lightMeta, stacked);
    const dark = (await prepare(logo(partner.logoDark), stacked)) ?? light;
    return { ...partner, light, dark };
  }),
);
---

<section id="partners" class="partners" aria-labelledby="partners-title" data-reveal>
  <div class="container head">
    <h2 class="label" id="partners-title">{site.partners.label}</h2>
    <button type="button" class="pause" data-marquee-toggle aria-pressed="false" hidden>{site.partners.pause}</button>
  </div>

  <div class="marquee" data-marquee>
    <div class="track">
      {
        [0, 1].map((group) => (
          <div class="group" aria-hidden={group === 1 ? 'true' : undefined}>
            {[0, 1].map((repeat) =>
              partners.map((partner) => (
                <a
                  class:list={['partner', { duplicate: repeat === 1 }]}
                  href={partner.href}
                  rel="noopener"
                  aria-hidden={repeat === 1 ? 'true' : undefined}
                  tabindex={group === 1 || repeat === 1 ? -1 : undefined}
                >
                  {partner.light && partner.dark ? (
                    <>
                      <img
                        class:list={['logo', 'for-light', { stacked: partner.logoStacked }]}
                        src={partner.light.src}
                        width={partner.light.width}
                        height={partner.light.height}
                        alt={partner.name}
                        loading="lazy"
                        decoding="async"
                      />
                      <img
                        class:list={['logo', 'for-dark', { stacked: partner.logoStacked }]}
                        src={partner.dark.src}
                        width={partner.dark.width}
                        height={partner.dark.height}
                        alt={partner.name}
                        loading="lazy"
                        decoding="async"
                      />
                    </>
                  ) : (
                    <span class="name">{partner.name}</span>
                  )}
                </a>
              )),
            )}
          </div>
        ))
      }
    </div>
  </div>

  <div class="container">
    <ul class="sentences">
      {
        site.partners.items.map((partner: Partner) => (
          <li class="sentence">
            <strong class="sentence-name">{partner.name}</strong>
            <span class="sentence-text">{partner.sentence}</span>
            {partner.unconfirmed && <span class="flag">{site.partners.unconfirmedFlag}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .partners {
    padding-block: 3rem;
  }

  .head {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .label {
    font-size: var(--text-xs);
    line-height: 1;
  }

  /* The pause control, shown by main.ts only where the logos move: a small text button. */
  .pause {
    min-height: 44px;
    padding: 0 0.75rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color var(--dur-fast);
  }

  .pause:hover {
    color: var(--ink);
  }

  .pause[aria-pressed='true'] {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Full bleed on the flat page, fading 10% at each edge. */
  .marquee {
    padding-block: 0.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--ink) 10%, var(--ink) 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--ink) 10%, var(--ink) 90%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
  }

  /* Each group pads its own tail by the gap, so the second copy lines up exactly where the first ends. */
  .group {
    display: flex;
    align-items: center;
    gap: 5rem;
    padding-right: 5rem;
  }

  .partner {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    text-decoration: none;
  }

  .partner:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  /* One file per theme; the dark theme is the default, so its variant shows unless the page says light. */
  .logo {
    display: block;
    height: 28px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
  }

  .logo.for-light,
  :global([data-theme='light']) .logo.for-dark {
    display: none;
  }

  :global([data-theme='light']) .logo.for-light {
    display: block;
  }

  /* Two-line lockups carry a tagline, so they need more height to read at the same size. */
  .logo.stacked {
    height: 38px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One group is two lists long, so twice the distance of a single list takes twice the time at the same speed. */
    .track {
      animation: marquee 84s linear infinite;
    }

    .marquee:hover .track,
    .marquee:focus-within .track,
    .marquee.is-paused .track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: no slide, no fade at the edges, one static row that wraps on narrow screens. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .track {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }

    .group[aria-hidden='true'],
    .partner.duplicate {
      display: none;
    }

    .group {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
      row-gap: 1rem;
    }
  }

  .sentences {
    display: grid;
    gap: 1rem 3rem;
    max-width: 960px;
    margin: 2rem auto 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .sentence-name {
    margin-right: 0.45rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .flag {
    margin-left: 0.45rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  @media (min-width: 768px) {
    .partners {
      padding-block: 4rem;
    }

    .sentences {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
