---
/**
 * The microphone glyph on the Talk button and on the conversation's hold-to-speak button: strokes in currentColor,
 * so it takes the text colour of whatever holds it. Decoration only; the control around it carries the name.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">
  <rect x="9" y="2.75" width="6" height="11.5" rx="3"></rect>
  <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.75 21h6.5"></path>
</svg>
