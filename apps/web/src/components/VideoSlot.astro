---
/**
 * A 16:9 panel for the Emily Wilson footage: flat navy, radius 8, a hairline, with a play button that stays disabled
 * until a self-hosted file exists, and a <video> ready for that file. Nothing is fetched and no third-party frame
 * is embedded. To switch it on: add <source> (and a captions <track>) to the video, remove `disabled` from the
 * button and let a script swap the panel for the player.
 */
import { site } from '../data/site.ts';

const { title, placeholder } = site.products.emily.video;
---

<figure class="video" data-video-slot>
  <div class="frame">
    <button class="play" type="button" disabled data-video-play aria-describedby="video-note">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="M8 5v14l11-7z" fill="currentColor" />
      </svg>
      <span class="vh">{title}</span>
    </button>

    <video class="player" preload="none" controls playsinline hidden data-video></video>
  </div>

  <figcaption class="caption">
    <span class="caption-title">{title}</span>
    <span class="note" id="video-note" data-video-note>{placeholder}</span>
  </figcaption>
</figure>

<style>
  .video {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-3d);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: transparent;
    color: var(--wire);
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .play svg {
    margin-left: 2px;
  }

  .play:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .play:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .player[hidden] {
    display: none;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .caption-title {
    font-weight: 600;
    color: var(--ink-2);
  }

  .note {
    color: var(--ink-muted);
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
