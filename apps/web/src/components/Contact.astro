---
/**
 * The contact form. A plain POST to /api/contact that the Worker answers with a redirect, so it works with
 * scripts off; scripts/contact.ts (loaded below) upgrades it to an inline submit, preselects ?topic= and stamps
 * the moment the form appeared. The honeypot and the timestamp are the bot checks; there is no captcha. The panel
 * is flat --bg-2 on the home page; on /contact it carries the page's one gloss.
 */
import { site } from '../data/site.ts';

interface Props {
  /** Render the eyebrow, title and lead above the form. The contact page has its own hero, so it turns this off. */
  intro?: boolean;
  /** The bottle-glass surface (global.css .gloss), at most once per page: /contact asks for it. */
  gloss?: boolean;
}

const { intro = true, gloss = false } = Astro.props;
const { contact } = site;
const { fields } = contact;

// The privacy note names the policy in its own words; that phrase becomes the link.
const phrase = contact.privacyLink;
const at = contact.privacyNote.indexOf(phrase);
const note =
  at >= 0
    ? { before: contact.privacyNote.slice(0, at), link: phrase, after: contact.privacyNote.slice(at + phrase.length) }
    : { before: contact.privacyNote + ' ', link: phrase, after: '' };
---

<section
  id="contact"
  class="contact section"
  aria-labelledby={intro ? 'contact-title' : undefined}
  aria-label={intro ? undefined : contact.eyebrow}
  data-reveal
>
  <div class="container">
    <div class:list={['inner', { split: intro }]}>
      {
        intro && (
          <div class="section-head">
            <p class="eyebrow">{contact.eyebrow}</p>
            <h2 id="contact-title">{contact.title}</h2>
            <p class="lead">{contact.lead}</p>
          </div>
        )
      }

      <div class:list={['panel', gloss ? 'gloss' : 'card']}>
        <div class="done" data-contact-done hidden tabindex="-1">
          <p class="done-title">{contact.sent.title}</p>
          <p class="done-text">{contact.sent.text}</p>
        </div>

        <form class="form" method="post" action="/api/contact" data-contact-form data-error-fallback={contact.error.text}>
          <div class="row">
            <div class="field">
              <label for="contact-name">{fields.name}</label>
              <input id="contact-name" name="name" type="text" required maxlength="80" autocomplete="name" />
            </div>
            <div class="field">
              <label for="contact-email">{fields.email}</label>
              {/* The pattern mirrors the Worker's rule, so a browser without scripts never posts an address it would refuse. */}
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                maxlength="160"
                autocomplete="email"
                inputmode="email"
                pattern="[^\s@]+@[^\s@.]+\.[^\s@]{2,}"
              />
            </div>
          </div>

          <div class="row">
            <div class="field">
              <label for="contact-company">
                {fields.company} <span class="optional">{fields.optional}</span>
              </label>
              <input id="contact-company" name="company" type="text" maxlength="120" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="contact-topic">{fields.topic}</label>
              <span class="select">
                {/* A placeholder that cannot be posted: without scripts no topic is chosen by accident. */}
                <select id="contact-topic" name="topic" data-contact-topic required>
                  <option value="" disabled selected>
                    {fields.topicPlaceholder}
                  </option>
                  {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
                </select>
                <svg class="chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path
                    d="m6 9 6 6 6-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          </div>

          <div class="field">
            <label for="contact-message">{fields.message}</label>
            <textarea id="contact-message" name="message" rows="5" required maxlength="1200"></textarea>
          </div>

          {/* Left empty by people, filled in by bots. Off screen, out of the tab order and hidden from assistive technology. */}
          <div class="trap" aria-hidden="true">
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="started" value="" data-contact-started />

          <p class="status" data-contact-status hidden tabindex="-1"></p>

          <div class="actions">
            <button class="btn btn-primary" type="submit" data-contact-submit>{contact.submit}</button>
            <p class="privacy">{note.before}<a href="/privacy">{note.link}</a>{note.after}</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact.ts';
</script>

<style>
  .inner {
    display: grid;
    gap: var(--head-gap);
    max-width: 720px;
  }

  .inner.split {
    max-width: none;
  }

  /* On the contact page the head above is a page head, so the form needs only a little air, not a section's. */
  .contact:not(:has(.section-head)) {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .panel {
    padding: 1.5rem;
  }

  .panel > * + * {
    margin-top: 0;
  }

  .form {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .form[hidden] {
    display: none;
  }

  .row {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-2);
  }

  .optional {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Fields 48px tall, radius 8, a 1px --field-border (3:1 or more against the panel). */
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--field-border);
    border-radius: var(--radius-sm);
    background: var(--field-bg);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-base);
    line-height: 1.5;
    transition: border-color var(--dur-fast);
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--ink-muted);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-color: var(--accent);
  }

  .field textarea {
    min-height: 160px;
    resize: vertical;
  }

  /* The select keeps the native menu and loses the native chrome; the chevron is ours. */
  .select {
    position: relative;
    display: block;
  }

  .select select {
    appearance: none;
    padding-right: 2.4rem;
    cursor: pointer;
  }

  .select option {
    background: var(--bg-2);
    color: var(--ink);
  }

  .chevron {
    position: absolute;
    top: 50%;
    right: 0.85rem;
    color: var(--ink-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .status {
    margin: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink);
  }

  .status[hidden] {
    display: none;
  }

  .status:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .actions {
    display: grid;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  /* "Send" is full width on phones and auto width on desktop. */
  .actions .btn {
    width: 100%;
  }

  [data-contact-submit][aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .privacy {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .privacy a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }

  .privacy a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .done {
    display: grid;
    gap: 0.6rem;
  }

  .done[hidden] {
    display: none;
  }

  .done:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .done-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
    line-height: 1.12;
    color: var(--ink);
  }

  .done-text {
    margin: 0;
    color: var(--ink-2);
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .actions .btn {
      width: auto;
      justify-self: start;
    }
  }

  @media (min-width: 768px) {
    .panel {
      padding: 2rem;
    }
  }

  /* Columns 1 to 5 for the head, 7 to 12 for the panel. */
  @media (min-width: 960px) {
    .inner.split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: calc(100% / 12);
      align-items: start;
    }
  }
</style>
