---
/**
 * The two beings, one above the other. Emily's card is the page's single gloss (global.css .gloss, the bottle-glass
 * recipe) with the points list, the video panel and the orange call to action that opens the Talk monitor; Krupiq
 * follows below her as a flat, compact row with an outline link, reached by scrolling. The tour highlights each
 * through data-product.
 */
import { site } from '../data/site.ts';
import VideoSlot from './VideoSlot.astro';

const { emily, krupiq } = site.products;
const external = (href: string): boolean => /^https?:\/\//.test(href);
---

<section id="products" class="products section" aria-labelledby="products-title" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{site.products.eyebrow}</p>
      <h2 id="products-title">{site.products.title}</h2>
    </div>

    <div class="stack">
      <article class="product gloss" data-product="emily">
        <div class="emily-grid">
          <div class="emily-copy">
            <p class="eyebrow">{emily.kicker}</p>
            <h3 class="name">{emily.name}</h3>
            <p class="text">{emily.lead}</p>
            <ul class="points">
              {emily.points.map((point) => <li>{point}</li>)}
            </ul>
            <p class="cta">
              <a class="btn btn-primary" href={emily.cta.href} data-talk-open>{emily.cta.label}</a>
            </p>
          </div>
          <div class="emily-video">
            <VideoSlot />
          </div>
        </div>
      </article>

      <article class="product card compact" data-product="krupiq">
        <div class="compact-copy">
          <p class="eyebrow">{krupiq.kicker}</p>
          <h3 class="name name-compact">{krupiq.name}</h3>
          <p class="text">{krupiq.lead}</p>
        </div>
        <p class="cta compact-cta">
          <a class="btn btn-ghost" href={krupiq.cta.href} rel={external(krupiq.cta.href) ? 'noopener' : undefined}>
            {krupiq.cta.label}
          </a>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: 1.5rem;
  }

  .product {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }

  .product > * + * {
    margin-top: 0;
  }

  .emily-grid {
    display: grid;
    gap: 1.5rem;
  }

  .emily-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .emily-copy > * + * {
    margin-top: 0;
  }

  /* Product names in Marcellus. */
  .name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: 1.12;
  }

  .name-compact {
    font-size: 1.5rem;
  }

  .text {
    color: var(--ink-2);
  }

  .points {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .points li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* An 8px outline triangle for a bullet: the one surviving use of the triangle motif. */
  .points li::before {
    content: '';
    position: absolute;
    top: 0.45em;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--accent-text);
    clip-path: polygon(evenodd, 0 0, 100% 50%, 0 100%, 1px 2.2px, 1px 5.8px, 6px 4px);
  }

  .cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .compact-copy {
    display: grid;
    gap: 0.5rem;
  }

  .compact-copy > * + * {
    margin-top: 0;
  }

  .compact-cta {
    margin-top: 0;
    padding-top: 0;
  }

  @media (min-width: 768px) {
    .product {
      padding: 2.5rem;
    }

    /* Krupiq: one row, the words on the left and the link at the right edge. */
    .product.compact {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem 2rem;
      padding: 1.5rem 2rem;
    }
  }

  @media (min-width: 960px) {
    /* Emily: the words in the wider column, the video panel beside them, both the full width of the page. */
    .emily-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }
</style>
