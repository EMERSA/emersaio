---
/**
 * The hero like the bottle's label: the face is the emblem, the H1 the wordmark, the label line the small print,
 * everything centred on a flat page. Two canvases share the stage: the raw WebGL hero cloud that paints the head
 * once the page is idle, and the three.js being (the kinect-demo look: the bust as tiny navy shards) that replaces
 * it when the device can carry it. On phones the stage is a 46svh block above the copy; from 720px it fills the
 * hero and the copy sits 48px above the hero's foot.
 *
 * The monitor is the one HUD drawn over the being: a translucent panel in phosphor green, like an old terminal,
 * that carries the tour's captions and controls while the tour runs and the Talk conversation (consent, then the
 * typed log with the hold-to-speak microphone button) when the visitor opens it. It is hidden until either starts. While the tour
 * scrolls the page it pins to the bottom edge as a full-width band (hud.css). Copy comes from site.ts; the scripts
 * find everything through data attributes, never ids.
 */
import { site } from '../data/site.ts';
import '../styles/hud.css';
import { TURNSTILE_SITEKEY } from '../lib/talk-config.ts';
import BeingStage from './BeingStage.astro';
import Captions from './Captions.astro';

// The avatar pipeline produces these files and a fresh checkout may lack them. Whatever exists reaches the scripts
// through data attributes; a missing attribute means the procedural cloud and the poster stand in.
const beingAssets = import.meta.glob('../assets/being/guide*.glb', { eager: true, query: '?url', import: 'default' });
const cloudAssets = import.meta.glob('../assets/being/cloud-*.bin', { eager: true, query: '?url', import: 'default' });
const assetUrl = beingAssets['../assets/being/guide.glb'];
const assetLiteUrl = beingAssets['../assets/being/guide-lite.glb'];
const cloudDesktop = cloudAssets['../assets/being/cloud-12k.bin'];
const cloudTouch = cloudAssets['../assets/being/cloud-6k.bin'];

const { hero, tour, talk, a11y } = site;
---

<section id="hero" class="hero" data-hero>
  <canvas
    class="hero-cloud"
    data-hero-canvas
    aria-hidden="true"
    data-cloud-touch={cloudTouch}
    data-cloud-desktop={cloudDesktop}></canvas>
  <div class="being-dock" data-being-dock>
    <BeingStage assetUrl={assetUrl} assetLiteUrl={assetLiteUrl} />
  </div>

  <div class="monitor" data-monitor hidden role="region" aria-label={a11y.talkPanel}>
    <div class="monitor-head">
      <span class="monitor-label" data-monitor-label data-tour-label={talk.tourLabel}></span>
      <span class="monitor-label voice-label" data-voice-label hidden>{hero.voiceLabel}</span>
      <button type="button" class="monitor-btn monitor-close" data-talk-close hidden>{talk.close}</button>
    </div>

    <div class="monitor-view" data-tour-view hidden>
      <Captions />
      <div class="tour-bar" data-tour hidden tabindex="-1" role="group" aria-label={a11y.tourControls}>
        <button type="button" class="monitor-btn" data-tour-back>{tour.back}</button>
        <button type="button" class="monitor-btn" data-tour-next>{tour.next}</button>
        <button type="button" class="monitor-btn" data-tour-replay>{tour.replay}</button>
        <button type="button" class="monitor-btn" data-tour-mute aria-pressed="false">{tour.mute}</button>
        <button type="button" class="monitor-btn" data-tour-end>{tour.end}</button>
        <span class="tour-progress num" data-tour-progress></span>
      </div>
      <p
        class="monitor-note"
        data-tour-notice
        hidden
        data-label-connection={tour.captionsOnly}
        data-label-still={tour.captionsOnlyStill}>{tour.captionsOnly}</p>
    </div>

    <div class="monitor-view talk-consent" data-talk-consent hidden>
      <p class="monitor-copy">{talk.intro}</p>
      <dl class="talk-terms">
        {
          talk.consent.map((item) => (
            <div class="talk-term">
              <dt>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="monitor-note">
        {talk.freeMinutes} {talk.aiNotice}
        <a href={talk.privacyLink.href}>{talk.privacyLink.label}</a>
      </p>
      <div class="talk-turnstile" data-talk-turnstile data-sitekey={TURNSTILE_SITEKEY}></div>
      <p class="talk-start">
        <button type="button" class="monitor-btn monitor-btn-primary" data-talk-start>{talk.start}</button>
      </p>
    </div>

    <div class="monitor-view talk-session" data-talk-session hidden>
      <p class="monitor-label talk-state" data-talk-state aria-live="polite"></p>
      <p class="monitor-howto">{talk.howTo}</p>
      <ol class="talk-log" data-talk-log aria-live="polite" aria-label={talk.title}></ol>
      <form class="talk-type" data-talk-form>
        <label class="sr-only" for="talk-input">{talk.typeLabel}</label>
        <span class="monitor-prompt" aria-hidden="true">&gt;</span>
        <input
          id="talk-input"
          class="talk-input"
          type="text"
          autocomplete="off"
          enterkeyhint="send"
          placeholder={talk.typePlaceholder}
          data-talk-input
        />
        <span class="monitor-caret" aria-hidden="true"></span>
        <button type="submit" class="monitor-btn">{talk.send}</button>
      </form>
      <div class="talk-actions">
        <button type="button" class="monitor-btn monitor-mic" data-talk-mic aria-pressed="false">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"
              fill="currentColor"></path>
          </svg>
          <span>{talk.speak}</span>
        </button>
        <label class="monitor-btn talk-upload">
          {talk.upload}
          <input
            class="sr-only"
            type="file"
            accept=".pdf,.txt,.md,application/pdf,text/plain,text/markdown"
            data-talk-file
          />
        </label>
        <button type="button" class="monitor-btn" data-talk-memory-open aria-expanded="false">
          {talk.memoryOpen}
        </button>
        <button type="button" class="monitor-btn" data-talk-end>{talk.end}</button>
      </div>
      <p class="monitor-note">{talk.uploadHint}</p>
      <section class="talk-memory" data-talk-memory hidden aria-labelledby="talk-memory-title">
        <h3 id="talk-memory-title" class="monitor-label">{talk.memoryTitle}</h3>
        <h4 class="monitor-label">{talk.memoryFacts}</h4>
        <ul data-memory-facts></ul>
        <h4 class="monitor-label">{talk.memoryFiles}</h4>
        <ul data-memory-files></ul>
        <h4 class="monitor-label">{talk.memoryTurns}</h4>
        <ul data-memory-turns></ul>
        <p><button type="button" class="monitor-btn" data-talk-forget>{talk.forget}</button></p>
      </section>
    </div>

    <p class="monitor-note talk-notice" data-talk-notice role="status" hidden></p>
  </div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-label label">{hero.eyebrow}</p>
      <h1 class="hero-title">{hero.title}</h1>
      <p class="lead hero-lead">{hero.lead}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={hero.primary.href} data-tour-start>{hero.primary.label}</a>
        <a class="btn btn-ghost" href={hero.talk.href} data-talk-open>{hero.talk.label}</a>
        <a class="btn btn-ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero.ts';
  import '../scripts/being-mount.ts';
  import '../scripts/talk-boot.ts';
</script>

<style>
  /* The sticky header sits in the flow above, so the first screen is 100svh less its height. Flat --bg: the only
     tone change on it is the rim light the runtime draws behind the head. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
    background: var(--bg);
  }

  /* The cloud paints behind everything and only once it has points; the heading is on screen first. */
  .hero-cloud {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero.is-ready .hero-cloud {
    opacity: 1;
  }

  /* The copy: centred, under the stage on phones, over the foot of the stage from 720px. */
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 1.5rem var(--gutter) 2rem;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* While the conversation is open the monitor takes the copy's place over the bust. */
  :global(html.is-talking) .hero-inner {
    opacity: 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    pointer-events: auto;
  }

  :global(html.is-talking) .hero-copy {
    pointer-events: none;
  }

  .hero-label {
    line-height: 1rem;
  }

  /* The bottle-wordmark moment: Marcellus, uppercase, tracked, two lines on desktop and three on phones. */
  .hero-title {
    max-width: 13em;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-h1);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink);
  }

  /* The full lead runs to two lines at this measure; the block below the chin stays within its 48px margin. */
  .hero-lead {
    max-width: 60ch;
    margin-top: 1rem;
    margin-inline: auto;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 1.5rem;
  }

  .hero-ctas .btn {
    width: 100%;
  }

  @media (min-width: 560px) {
    .hero-ctas {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    .hero-ctas .btn {
      width: auto;
    }
  }

  @media (min-width: 720px) {
    /* The head takes 47% of the hero and the copy block about 310px; under 780px the two would meet, so a short
       viewport scrolls a little rather than putting the label on the chin. */
    .hero {
      justify-content: flex-end;
      min-height: max(calc(100svh - var(--header-h)), 780px);
    }

    /* The dock is the whole hero (hud.css); the copy is anchored 48px above the hero's foot. */
    .hero-inner {
      padding: 0 var(--gutter) 3rem;
    }

    .hero-ctas {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cloud,
    .hero-inner {
      transition: none;
    }
  }
</style>
