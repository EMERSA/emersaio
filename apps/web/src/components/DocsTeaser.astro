---
/** The documentation teaser: a column under a hairline. It shares one two-column band with GamesTeaser on the home page. */
import { site } from '../data/site.ts';

const { docs } = site;
---

<section class="column teaser" aria-labelledby="docs-title">
  <p class="eyebrow">{docs.eyebrow}</p>
  <h2 class="title" id="docs-title">{docs.title}</h2>
  <p class="text">{docs.lead}</p>
  <p class="cta">
    <a class="btn btn-ghost btn-sm" href={docs.cta.href}>{docs.cta.label}</a>
  </p>
</section>

<style>
  .teaser {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .title {
    font-size: var(--text-title);
  }

  .cta {
    margin-top: auto;
    padding-top: 1.25rem;
  }
</style>
