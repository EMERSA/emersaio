---
/**
 * The home page: the being's hero, then the sections in the order the scripted tour walks them: About, Products
 * (Emily first, Krupiq below her), Technology, Partners, the docs teaser and the tour transcript. Whitespace divides
 * the page: no dividers and no bands.
 */
import About from '../components/About.astro';
import DocsTeaser from '../components/DocsTeaser.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import Products from '../components/Products.astro';
import Technology from '../components/Technology.astro';
import TourTranscript from '../components/TourTranscript.astro';
import Base from '../layouts/Base.astro';
import { graph, organization } from '../lib/schema.ts';

const schema = graph(organization());
---

<Base being="tour" schema={schema}>
  <Hero />
  <About />
  <Products />
  <Technology />
  <Partners />
  <div class="teasers" data-reveal>
    <div class="container teasers-grid">
      <DocsTeaser />
    </div>
  </div>
  <TourTranscript />
</Base>

<style>
  .teasers {
    padding-block: var(--section-y);
  }

  .teasers-grid {
    max-width: calc(760px + 2 * var(--gutter));
  }
</style>
