# dependencies and build output
node_modules/
dist/
.astro/
.wrangler/
.kilo/
*.tsbuildinfo

# local environment and secrets (never commit)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# generated by wrangler types
worker/worker-configuration.d.ts

# avatar pipeline intermediates (large); the built guide.glb lives in apps/web/src/assets/being
tools/avatar/src/*.blend
tools/avatar/src/*.blend1
tools/avatar/out/
tools/avatar/cache/
__pycache__/

# test and tooling artefacts
.lighthouseci/
tests/browser/out/
playwright-report/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# the kinect harness's local files (apps/web/public/dev: the Kinectron browser client and depth recordings) never
# ship and are never committed; only the README and the folder's own .gitignore are tracked
apps/web/public/dev/*
!apps/web/public/dev/README.md
!apps/web/public/dev/.gitignore
