{
  "ci": {
    "collect": {
      "startServerCommand": "node tests/browser/static-serve.mjs apps/web/dist 4330",
      "startServerReadyPattern": "serving",
      "url": ["http://127.0.0.1:4330/", "http://127.0.0.1:4330/docs"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ":4330/$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 24064 }],
            "resource-summary:document:size": ["error", { "maxNumericValue": 16384 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 18432 }],
            "resource-summary:font:size": ["warn", { "maxNumericValue": 76800 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 409600 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/docs$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 7168 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 307200 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
